{
  "family": "biobricks-pdaa",
  "networkMode": "awsvpc",
  "containerDefinitions": [
      {
          "name": "pdaa-streamlit",
          "image": "010438487580.dkr.ecr.us-east-1.amazonaws.com/biobricks/pdaa:latest",
          "memory": 15000, 
          "cpu": 4096, 
          "essential": true,
          "portMappings": [
              {
                  "containerPort": 8501,
                  "hostPort": 8501,
                  "protocol": "tcp"
              }
          ],
          "environment": [
              {
                  "name": "STREAMLIT_APP",
                  "value": "streamlit_app.py"
              },
              {
                  "name": "ROOT_URL",
                  "value": "http://localhost:8501"
              }
          ]
      }
  ],
  "requiresCompatibilities": ["EC2"],
  "memory": "15000",
  "cpu": "4096",
  "executionRoleArn": "arn:aws:iam::010438487580:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::010438487580:role/ecsTaskRole"
}
